# --- Canvas Emailer ---
def send_canvas_messages(items, template, sender_email):
    """Sends direct Canvas inbox messages to students, masquerading as the staff member."""
    if not CANVAS_BASE_URL or not CANVAS_TOKEN:
        raise Exception("Canvas credentials are missing from Acalanes.json!")

    headers = {"Authorization": f"Bearer {CANVAS_TOKEN}"}

    for item in items:
        student_email = item.get('StudentEmail')
        if not student_email: continue

        # STEP 1: Ask Canvas for the student's internal raw integer ID
        user_url = f"{CANVAS_BASE_URL.rstrip('/')}/api/v1/users/sis_login_id:{student_email}"
        user_resp = requests.get(user_url, headers=headers)

        if not user_resp.ok:
            raise Exception(f"Could not find student by email ({student_email}) in Canvas: {user_resp.text}")

        canvas_raw_id = user_resp.json().get('id')

        # STEP 2: Prepare the message body
        body = template.replace('[FirstName]', item['StudentFirstName'] or '') \
                       .replace('[LastName]', item['StudentLastName'] or '') \
                       .replace('[Barcode]', item['ItemBarcode'] or '')
        date_str = item['CheckoutDateTime'].strftime('%Y-%m-%d') if hasattr(item['CheckoutDateTime'], 'strftime') else str(item['CheckoutDateTime'])
        body = body.replace('[Date]', date_str)

        # STEP 3: Send message using the RAW integer ID AND masquerade as the staff
        msg_url = f"{CANVAS_BASE_URL.rstrip('/')}/api/v1/conversations"
        payload = {
            "recipients[]": canvas_raw_id,
            "subject": "Overdue Library/Device Notice",
            "body": body,
            "force_new": True,
            "as_user_id": f"sis_login_id:{sender_email}" # <-- The Magic Masquerade Parameter
        }

        response = requests.post(msg_url, headers=headers, data=payload)

        if not response.ok:
            raise Exception(f"Canvas API Error ({response.status_code}): {response.text}")

# --- DATABASE HELPER ---
def get_db_connection():
    return pymssql.connect(
        server=configs.get('LocalAERIES_DBServer'),
        user=configs.get('LocalAERIES_Username'),
        password=configs.get('LocalAERIES_Password'),
        database=configs.get('LocalAUHSD'),
        as_dict=True
    )

def get_user_site(cursor, email):
    cursor.execute("SELECT SchoolSite FROM UserSettings WHERE UserEmail = %s", (email,))
    row = cursor.fetchone()
    return row['SchoolSite'] if row and row['SchoolSite'] else None

